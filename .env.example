# Flask Configuration
FLASK_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
FLASK_ENV=development
PORT=5000

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=interview_experience_portal
# Set to true if you want to force SQLite local development file without running MySQL
USE_SQLITE_FALLBACK=false

# AI Provider Configuration ('gemini' or 'openai')
AI_PROVIDER=gemini

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Semantic Vector Search
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Security & Uploads
MAX_CONTENT_LENGTH=10485760 # 10MB
UPLOAD_FOLDER=uploads/resumes
